{
  "dataset": "pmp_patient_services",
  "source_system": "salesforce_pmp_synthetic",
  "source_file": "pmp_cdc.jsonl",
  "load_mode": "incremental_cdc",
  "primary_key": "event_id",
  "required_fields": ["event_id", "patient_id", "program", "status", "consent", "event_ts", "source_version"],
  "allowed_programs": ["RESPIRA", "IMMUNO", "ONCOLOGY"],
  "allowed_statuses": ["ENROLLED", "CONTACTED", "SERVICE_ACTIVE", "COMPLETED"],
  "max_reject_rate": 0.03,
  "classification": "synthetic_sensitive_domain_example",
  "direct_identifiers": ["patient_id"],
  "outbound_requires_consent": true,
  "retention_days": 30
}
